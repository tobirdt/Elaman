# Public site. Already set on Vercel.
NEXT_PUBLIC_SITE_URL=https://www.elaman.de
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Portal. Not needed to build or run the public site; the database is only
# opened when a portal route asks for it.
#
# Neon project "elaman", AWS Europe Central 1 (Frankfurt), branch "production".
# Take the string from the console under Connect; the pooled host (the one with
# -pooler in it) is the right one for the application.
#
# The driver speaks Postgres over a WebSocket on 443 rather than a socket on
# 5432, so this also works from networks that only allow HTTPS — and it is what
# Neon recommends for serverless functions.
#
# A local Postgres works too, for development without touching the real data:
#   DATABASE_URL=postgres://postgres@127.0.0.1:5433/elaman_dev
DATABASE_URL=
DATABASE_POOL_MAX=4

# Documents. Neon Object Storage, same project and region as the database,
# bucket "dokumente", private — a file is only ever handed out through a
# presigned link that expires.
#
# S3-compatible, so any S3 client works, but the credentials are not in the
# console: they come from `neon credentials create --scope storage:read
# --scope storage:write` (or the matching API call), and they are shown once.
# The key ids are Neon's own (nak_live_… / nsk_live_…), not AWS keys.
#
# The endpoint is per branch: https://<branch-id>.storage.<region-host>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=dokumente
