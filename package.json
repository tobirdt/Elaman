{
  "name": "elaman-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:iphone": "playwright test --project=iphone-webkit --project=iphone-landscape-webkit",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "24.13.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "postcss": "8.5.26",
    "prettier": "^3.8.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
